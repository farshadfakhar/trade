{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "start": "prisma db push --skip-generate && node --env-file-if-exists=../.env --import tsx src/main.ts",
    "hash-password": "tsx src/hash-password.ts",
    "backtest": "node --env-file-if-exists=../.env --import tsx src/backtest/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.8",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "technicalindicators": "^3.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
