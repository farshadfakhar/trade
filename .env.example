# Mode: paper (default) or live. Live also needs UI confirmation (Phase 3+).
TRADING_MODE=paper
NOBITEX_BASE_URL=https://apiv2.nobitex.ir
# Live only. Nobitex key: READ+TRADE only (no WITHDRAW), IP-whitelisted, short expiry.
# KEY = Nobitex-Key (public). SECRET = Ed25519 private key (URL-safe base64).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Strategy the bot runs: emaRsi (1h) | donchian (4h) | pullback (4h) | pullback15m (15m + 1h trend)
STRATEGY=emaRsi
# Coin scanner: the bot picks the coin itself (needs a strategy with years of history: donchian, pullback or emaRsi)
AUTO_SCAN=false
SCAN_INTERVAL_HOURS=24
SCAN_MIN_VOLUME_USDT=100000   # only liquid markets; most Nobitex USDT markets trade far less
SCAN_MAX_SPREAD_PCT=0.3
SCAN_TOP_N=12
SCAN_MIN_OOS_TRADES=8
SCAN_MIN_OOS_PF=1.2
SCAN_MAX_DD_PCT=12
BOT_CAPITAL_USDT=50
RISK_PER_TRADE_PCT=1
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=5
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=10
PAIR=BTC/USDT   # the coin to trade. With AUTO_SCAN=true the scanner chooses the coin instead
STALE_DATA_SECONDS=60
MAX_EXCHANGE_ERRORS=3
FEE_PCT=0.13
SLIPPAGE_PCT=0.05

# Dashboard (generate hash: cd server && npm run hash-password -- "your 12+ char password")
DASHBOARD_PASSWORD_HASH=   # keep the single quotes that hash-password prints
JWT_SECRET=            # 32+ random chars, e.g. openssl rand -hex 32
HOST=127.0.0.1         # keep local; put an HTTPS reverse proxy in front for remote access
PORT=3000
COOKIE_SECURE=true     # set false only for plain-http local dev
TRUST_PROXY=false      # true only behind your own reverse proxy (docker-compose sets it for you)
